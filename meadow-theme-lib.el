(defconst meadow-theme-variants '(meadow meadow-light)
  "The themes in this package.")

(defun meadow-theme-current ()
  "Return the Meadow theme that is currently enabled, or nil."
  (seq-find (lambda (theme) (memq theme meadow-theme-variants))
            custom-enabled-themes))

(defun meadow-theme-color (name &optional theme)
  "Return the hex code of the color NAME in THEME.
NAME is a symbol like `lavender', `lavender-soft' or `base'.  THEME
defaults to the Meadow theme that is currently enabled, falling back to
`meadow'."
  (alist-get name (alist-get (or theme (meadow-theme-current) 'meadow)
                             meadow-theme-palettes)))

;;;###autoload
(defun meadow-theme-load (theme)
  "Disable every enabled theme, then load the Meadow THEME."
  (interactive
   (list (intern (completing-read "Load Meadow theme: "
                                  meadow-theme-variants nil t))))
  (unless (memq theme meadow-theme-variants)
    (user-error "%s is not a Meadow theme" theme))
  (mapc #'disable-theme custom-enabled-themes)
  (load-theme theme :no-confirm))

;;;###autoload
(defun meadow-theme-toggle ()
  "Switch between Meadow and Meadow Light."
  (interactive)
  (meadow-theme-load (if (eq (meadow-theme-current) 'meadow)
                         'meadow-light
                       'meadow)))

(defun meadow-theme--run-hook (theme)
  "Run `meadow-theme-after-load-hook' if THEME is a Meadow theme."
  (when (memq theme meadow-theme-variants)
    (run-hooks 'meadow-theme-after-load-hook)))

(add-hook 'enable-theme-functions #'meadow-theme--run-hook)

(defmacro meadow-theme--with-colors (theme &rest body)
  "Evaluate BODY with every color of THEME bound to its name."
  (declare (indent 1))
  (let ((palette (make-symbol "palette")))
    `(let* ((,palette (alist-get ,theme meadow-theme-palettes))
            ,@(mapcar (lambda (name) `(,name (alist-get ',name ,palette)))
                      meadow-theme--color-names))
       (ignore ,@meadow-theme--color-names)
       ,@body)))

(defun meadow-theme--height (level)
  "Return a :height property for a heading at LEVEL, or nil."
  (when-let* ((height (nth (1- level) meadow-theme-heading-heights)))
    (list :height height)))

