(defun meadow-theme--variables (theme)
  "Return the variable settings for THEME as a list of (VARIABLE VALUE)."
  (meadow-theme--with-colors theme
    `((hl-todo-keyword-faces
       '(("TODO" . ,poppy)
         ("FIXME" . ,poppy)
         ("BUG" . ,poppy)
         ("XXX" . ,poppy)
         ("HACK" . ,marigold)
         ("WARN" . ,marigold)
         ("DEBUG" . ,dew)
         ("NOTE" . ,dew)
         ("REVIEW" . ,cornflower)
         ("GOTCHA" . ,lavender)
         ("DONE" . ,sage)
         ("OKAY" . ,sage))))))

(defun meadow-theme--apply (theme)
  "Set every face and variable of the Meadow THEME."
  (apply #'custom-theme-set-faces theme
         (mapcar (lambda (spec) `(,(car spec) ((t ,(cdr spec)))))
                 (meadow-theme--faces theme)))
  (apply #'custom-theme-set-variables theme
         (meadow-theme--variables theme)))

