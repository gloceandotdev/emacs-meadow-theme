(require 'seq)

(defgroup meadow-theme nil
  "A smoky color palette that's easy on the eyes."
  :group 'faces
  :prefix "meadow-theme-"
  :link '(url-link "https://github.com/gloceandotdev/meadow"))

(defcustom meadow-theme-italic t
  "When non-nil, use italics for comments, docstrings and quotes.
Reload the theme after changing this."
  :type 'boolean)

(defcustom meadow-theme-heading-heights nil
  "Heights for Org, Outline and Markdown headings.
When nil, every heading uses the default size.  Reload
the theme after changing this."
  :type '(repeat number))

(defcustom meadow-theme-after-load-hook nil
  "Hook run after a Meadow theme is enabled.
Use it for anything in your config that depends on the palette, together
with `meadow-theme-color'."
  :type 'hook)

(eval-and-compile
